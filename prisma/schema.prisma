generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum SkillType {
  PROGRAMMING_LANGUAGE
  FRAMEWORK
  SOFT_SKILL
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  location      String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isOnboarded   Boolean   @default(false)

  accounts         Account[]
  profile          Profile?
  workExperiences  WorkExperience[]
  skills           UserSkill[]
  certifications   Certification[]
  languages        UserLanguage[]
  skillAssessments SkillAssessment[]
  careerInterests  CareerInterests?
  recommendations  Recommendation[]
  savedCareerPaths SavedCareerPath[]
  skillGoals       SkillGoal[]
}

model Account {
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("account")
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@map("verification_token")
}

model Profile {
  id                   String  @id @default(cuid())
  jobTitle             String?
  highestDegree        String?
  fieldOfStudy         String?
  academicAchievements String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkExperience {
  id                       String    @id @default(cuid())
  jobTitle                 String
  company                  String
  rolesAndResponsibilities String
  isInternship             Boolean   @default(false)
  startDate                DateTime
  endDate                  DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id   String    @id @default(cuid())
  name String    @unique
  type SkillType

  users UserSkill[]
}

model UserSkill {
  id          String @id @default(cuid())
  proficiency Int

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model Certification {
  id             String    @id @default(cuid())
  name           String
  platform       String
  completionDate DateTime?
  expirationDate DateTime? // ADDED — mockup has "Expiration Date (Optional)"
  credentialUrl  String? // ADDED — mockup has "Credential URL (Optional)"

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Language {
  id   String @id @default(cuid())
  name String @unique

  users UserLanguage[]
}

model UserLanguage {
  id          String @id @default(cuid())
  proficiency String

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([userId, languageId])
}

model SkillAssessment {
  id         String   @id @default(cuid())
  assessment String
  score      Int
  takenAt    DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CareerInterests {
  id                  String   @id @default(cuid())
  preferredJobRoles   String[] // CHANGED from String — mockup shows multiple removable tags, not one value
  preferredIndustries String
  careerGoals         String?
  githubUrl           String?
  portfolioUrl        String?
  linkedinUrl         String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id             String   @id @default(cuid())
  careerPaths    Json // [{ title, matchScore, rationale, tags: [] }]
  skillGaps      Json // [{ skillName, note }]
  inDemandSkills Json // [ skillName, ... ]
  createdAt      DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedCareerPath {
  id      String   @id @default(cuid())
  title   String
  savedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SkillGoal {
  id          String   @id @default(cuid())
  skillName   String
  courseTitle String?
  courseUrl   String?
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
}
